[Unit]
Description=Bug Tracker Flask Application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ci-cd-project
ExecStart=/home/ubuntu/ci-cd-project/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=bugtracker

[Install]
WantedBy=multi-user.target
